{#
/**
 * @file
 * Contains the template to display the campus map page.
 */
#}
{% if ucb_rave_alerts %}
  {# position-relative + z-3 keep an active alert above the fullscreen iframe. #}
  <rave-alert class="position-relative z-3 d-block" feed="https://www.getrave.com/rss/cuboulder/channel1" link="https://alerts.colorado.edu"></rave-alert>
{% endif %}
<main>
  <a id="main-content" tabindex="-1"></a>
  <h1 class="visually-hidden">
    {{ page['#title'] }}
  </h1>
  <p class="visually-hidden">
    CU Boulder is committed to making information available via assistive technologies. The campus map has known issues with certain assistive technologies that we are working with the supplier to resolve.
  </p>
  <iframe class="position-absolute d-block w-100 h-100 border-0" id="campusMap" width="100%" height="100%" src="https://map.concept3d.com/?id=336" frameborder="0" scrolling="no" border="0" allow="geolocation;fullscreen"></iframe>
</main>
<script type="text/javascript">
  (function(campusMap){
    const baseURL = 'https://map.concept3d.com/?id=336';
    function updateHash() {
      // Passes hash through to the map iframe.
      campusMap.src = baseURL + window.location.hash;
    }
    if (window.location.hash) {
      updateHash();
    }
    window.addEventListener('hashchange', updateHash);
  })(document.getElementById('campusMap'));
</script>
